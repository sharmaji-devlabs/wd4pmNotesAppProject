<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emptySearchCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">


    <!-- Search Box -->
    <LinearLayout
         android:layout_margin="35dp"
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/search_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/searchText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Food Recipe"
            android:textColor="#AFAFAF"
            android:textSize="12sp"/>

        <ImageView
            android:id="@+id/clearSearch"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/cross"
            android:contentDescription="Clear search"/>

    </LinearLayout>


    <!-- Center Image + Text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">


        <!-- Bigger Empty Illustration -->
        <ImageView
            android:id="@+id/emptyIllustration"
            android:layout_width="330dp"
            android:layout_height="240dp"
            android:scaleType="fitCenter"
            android:src="@drawable/search_screen_image"
            android:contentDescription="No file found"/>


        <!-- Bigger Text -->
        <TextView
            android:id="@+id/emptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="File not found. Try searching again."
            android:textColor="#C5C5C5"
            android:textSize="16sp"/>

    </LinearLayout>

</LinearLayout>